# Copy to .env and fill in. Never commit .env.
APP_NAME=geospatial-risk-mapper
LOG_LEVEL=INFO

# Directory containing the manually-downloaded ISPRA flood hazard shapefiles
# (HPH_*.shp / MPH_*.shp / LPH_*.shp). Used by app.py (train.py takes this as
# a CLI/Makefile argument instead: `make train FLOOD_PATH=...`).
# See data/README.md for download instructions.
# FLOOD_PATH=./data/ispra_shapefiles

# DATA_DIR=./data
# MODELS_DIR=./models
# RANDOM_STATE=42
